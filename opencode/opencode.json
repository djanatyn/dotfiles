{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
       "*": "ask",
       "ls *": "allow",
       "mkdir *": "allow",
       "grep *": "allow",
       "rg *": "allow",
       "poetry run ruff *": "allow",
       "poetry run mypy *": "allow",
       "poetry run trial *": "allow",
       "wc *": "allow",
       "head *": "allow",
       "tail *": "allow",
       "find *": "ask",
       "git *": "ask",
       "git commit": "deny",
       "git log *": "allow",
       "git show *": "allow",
       "git diff *": "allow",
       "git branch *": "allow",
       "rm *": "deny"
    }
  }
}
